# Copy to .env. Generate unique secrets; never commit the real file.
POSTGRES_DB=omya_hospital
POSTGRES_USER=omya
POSTGRES_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=replace-with-a-strong-admin-password
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
MANAGEMENT_PORT=9091
